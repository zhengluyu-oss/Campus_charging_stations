# 校园充电桩管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值，或在系统环境变量中设置

# ===== 数据库配置 =====
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===== JWT 密钥 =====
# 必须至少 32 字节，生产环境请使用强随机密钥
# 生成方式: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_bytes_here

# ===== 文件上传路径 =====
FILE_UPLOAD_PATH=/data/uploads
FILE_BASE_PATH=/data/uploads

# ===== 日志路径 =====
LOG_PATH=/var/log/campus-charging/app.log
